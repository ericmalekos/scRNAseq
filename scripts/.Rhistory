sce          = sce_global,
gene_id      = "Gm20703",
assay_name   = "logcounts",
group_mode   = "cell_type",
cell_type_col = "cell_ontology_class",
top_n        = 20,
min_cells_per_group = 50,
top_stat       = "mean",
#tissue_exclude = c("nan"),
tissue_col   = "tissue",
x_title             = "log(CPM + 1)",
y_title             = "Cell ontology class",
main_title          = "Gaplinc expression in top 20 cells",
legend_title        = "Cell type",
